---
/**
 * Como a licenca funciona. Fica ANTES da compra de proposito: o cliente
 * precisa saber que a chave e presa a placa-mae, que formatar nao custa
 * chave nova e que trocar a placa custa uma reemissao — agora, e nao no dia
 * em que acontecer. Vale igual nas tres linguas.
 *
 * Texto dos cartoes e dos tres passos: src/data/i18n/<idioma>.ts (`licenca`),
 * tirados de pc-optimizer/docs/LICENCA.md.
 */
import type { Conteudo } from "../data/i18n";

interface Props {
  t: Conteudo;
}

const { t } = Astro.props;
---

<section id="licenca" class="scroll-mt-16 border-b border-linha">
  <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-32">
    <header class="max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-tinta-3 sm:text-xs">
        {t.licenca.rotulo}
      </p>
      <h2
        class="mt-6 text-pretty text-2xl font-semibold leading-[1.2] tracking-tight text-tinta sm:text-3xl md:text-4xl"
      >
        {t.licenca.titulo}
      </h2>
    </header>

    <!-- As tres regras da licenca -->
    <ul class="mt-12 grid grid-cols-1 gap-x-10 gap-y-9 sm:mt-16 md:grid-cols-3">
      {
        t.licenca.itens.map((item) => (
          <li class="border-t border-linha-forte pt-5">
            <h3 class="text-[0.9375rem] font-semibold leading-snug tracking-[-0.005em] text-tinta sm:text-base">
              {item.titulo}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-tinta-2 sm:text-[0.9375rem]">
              {item.texto}
            </p>
          </li>
        ))
      }
    </ul>

    <!-- O caminho da chave, do instalador ao campo -->
    <div class="mt-16 border-t border-linha pt-12 sm:mt-20 sm:pt-14">
      <p class="rotulo">{t.licenca.fluxoRotulo}</p>
      <ol class="mt-8 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
        {
          t.licenca.fluxo.map((passo) => (
            <li>
              <p class="tabular font-mono text-xs tracking-[0.14em] text-tinta-3">
                {passo.passo}
              </p>
              <h3 class="mt-3 text-[0.9375rem] font-semibold leading-snug text-tinta">
                {passo.titulo}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-tinta-2">{passo.texto}</p>
            </li>
          ))
        }
      </ol>

      <p class="mt-10 max-w-2xl border-l border-linha-forte pl-5 text-sm leading-relaxed text-tinta-2">
        {t.licenca.nota}
      </p>
    </div>
  </div>
</section>

<style>
  .rotulo {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-tinta-3);
  }
</style>
