---
/**
 * /comprar — o caminho da compra, em quatro passos.
 *
 * POR QUE ESTA PAGINA EXISTE, E POR QUE ELA COMECA MANDANDO INSTALAR
 *
 * A licenca do Otimiza nasce presa ao codigo OTZ-XXXX-XXXX-XXXX, que sai do
 * numero de serie da placa-mae. Esse codigo so aparece DEPOIS de instalar, no
 * portao da primeira abertura. Quem chega aqui querendo pagar primeiro precisa
 * ser avisado, senao paga e fica com uma chave sem ter onde colar.
 *
 * Nao e uma limitacao que a pagina esconde: e a primeira coisa que ela diz.
 *
 * DOIS CANAIS, UMA PAGINA
 *
 * Com `PUBLIC_OTIMIZA_API` definida na compilacao, o pagamento acontece aqui
 * mesmo: Pix gerado na hora e a chave entregue na tela. Sem ela, a pagina cai
 * no caminho do Discord, que funciona desde sempre.
 *
 * A escolha e da COMPILACAO, e nao do navegador. Uma pagina que tenta o
 * checkout e descobre no clique que a API nao existe deixaria o cliente
 * esperando por um erro; assim, o que nao funciona nem aparece.
 *
 * O checkout nao substitui o Discord — ele fica ao lado. Quem prefere falar
 * com uma pessoa continua tendo para onde ir, no mesmo preco.
 */
import Base from "../layouts/Base.astro";
import Cabecalho from "./Cabecalho.astro";
import Rodape from "./Rodape.astro";
import { traducoes, caminho } from "../data/i18n";
import type { Idioma } from "../data/i18n";
import { produto } from "../data/produto";
import { precosDe } from "../data/precos";
import { TEM_CHECKOUT } from "../data/api";
import Checkout from "./Checkout.astro";

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = traducoes[idioma];
const c = t.comprar;
const precos = precosDe(idioma);

/*
  CONVITE DO DISCORD — PRECISA SER PERMANENTE.

  O que esta aqui e o mesmo que o produto usa em src/main.ts. Ele foi conferido
  na API do Discord e VENCE EM 28/09/2026.

  Num site isso tem conserto: republicar. No executavel que o cliente ja
  instalou, nao tem — nao ha camada de rede para atualizar o endereco. Por isso
  o convite permanente importa nos dois lugares, e mais no produto do que aqui.
*/
const CONVITE_DISCORD = "https://discord.gg/fmeQVJphC";
---

<Base idioma={idioma} title={c.tituloPagina} description={c.descricaoPagina} sufixo="/comprar">
  <Cabecalho idioma={idioma} t={t} sufixo="/comprar" />

  <main id="conteudo">
    <section id="topo" class="border-b border-linha">
      <div class="mx-auto w-full max-w-6xl px-5 pb-16 pt-16 sm:px-8 sm:pb-20 sm:pt-24 lg:px-12 lg:pt-28">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-tinta-3 sm:text-xs">
          {c.rotulo}
        </p>

        <h1
          class="mt-6 max-w-[22ch] text-pretty text-[1.75rem] font-semibold leading-[1.12] tracking-tight text-tinta sm:text-4xl md:text-5xl"
        >
          {c.titulo}
        </h1>

        <p class="mt-7 max-w-2xl text-base leading-relaxed text-tinta-2 sm:text-lg">
          {c.texto}
        </p>

        <p class="tabular mt-8 font-mono text-xs leading-relaxed text-tinta-3">
          {precos.aVista.completo}{t.precos.sufixoMoeda ? ` ${t.precos.sufixoMoeda}` : ""}
          <span aria-hidden="true"> · </span>
          {t.precos.formas.join(" · ")}
          <span aria-hidden="true"> · </span>
          {t.precos.processadoPor}
        </p>
      </div>
    </section>

    {/* Os quatro passos. A numeracao e o assunto: a ordem e o conteudo. */}
    <section class="border-b border-linha">
      <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
        <ol class="grid grid-cols-1 gap-x-10 gap-y-12 md:grid-cols-2">
          {
            c.passos.map((p) => (
              <li class="border-t border-linha pt-6">
                <p class="tabular font-mono text-xs text-tinta-3">{p.numero}</p>
                <h2 class="mt-4 text-lg font-semibold leading-snug tracking-tight text-tinta sm:text-xl">
                  {p.titulo}
                </h2>
                <p class="mt-3 max-w-prose text-sm leading-relaxed text-tinta-2 sm:text-base">
                  {p.numero === "03" && TEM_CHECKOUT ? c.passoPagarAqui : p.texto}
                </p>

                {p.numero === "01" && (
                  <a
                    href={produto.instalador}
                    rel="noopener"
                    class="mt-6 inline-flex items-center justify-center rounded-sm bg-inverso px-6 py-3 text-sm font-medium text-inverso-tinta transition-opacity hover:opacity-85"
                  >
                    {c.acaoBaixar}
                  </a>
                )}

{/* O botao do Discord so aparece aqui quando NAO ha checkout. Com
                    checkout, o Discord continua oferecido — mas dentro da
                    secao de pagamento, como alternativa, e nao como o caminho. */}
                {p.numero === "03" && !TEM_CHECKOUT && (
                  <>
                    <a
                      href={CONVITE_DISCORD}
                      rel="noopener"
                      class="mt-6 inline-flex items-center justify-center rounded-sm border border-linha-forte px-6 py-3 text-sm font-medium text-tinta transition-colors hover:border-tinta"
                    >
                      {c.acaoDiscord}
                    </a>
                    <p class="mt-4 max-w-prose text-xs leading-relaxed text-tinta-3">
                      {c.notaDiscord}
                    </p>
                  </>
                )}

                {p.numero === "03" && TEM_CHECKOUT && (
                  <a
                    href="#checkout"
                    class="mt-6 inline-flex items-center justify-center rounded-sm bg-inverso px-6 py-3 text-sm font-medium text-inverso-tinta transition-opacity hover:opacity-85"
                  >
                    {t.checkout.rotulo}
                  </a>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/*
      COM CHECKOUT, O CONFERIDOR SOME — e nao por economia de tela.

      Os dois pedem a mesma coisa, um do lado do outro: um so confere a
      forma do codigo, o outro confere e cobra. Duas caixas iguais fazem a
      pessoa preencher a errada, e a errada e a que nao vende.

      Sem checkout ele continua valendo: e o unico jeito de descobrir que o
      codigo esta errado ANTES de levar ele para o Discord e pagar.
    */}
    {!TEM_CHECKOUT && (
      <section class="border-b border-linha bg-papel-2">
        <div class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-24 lg:px-12">
          <div class="max-w-2xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-tinta-3 sm:text-xs">
              {c.conferidor.rotulo}
            </p>
            <h2
              class="mt-6 text-pretty text-2xl font-semibold leading-[1.2] tracking-tight text-tinta sm:text-3xl"
            >
              {c.conferidor.titulo}
            </h2>
            <p class="mt-5 text-sm leading-relaxed text-tinta-2 sm:text-base">
              {c.conferidor.texto}
            </p>

            <form id="forma-codigo" class="mt-8" novalidate>
              <label
                for="codigo-maquina"
                class="block font-mono text-[11px] uppercase tracking-[0.18em] text-tinta-3"
              >
                {c.conferidor.etiqueta}
              </label>

              <div class="mt-3 flex flex-col gap-3 sm:flex-row">
                <input
                  id="codigo-maquina"
                  name="codigo"
                  type="text"
                  inputmode="text"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="OTZ-XXXX-XXXX-XXXX"
                  aria-describedby="resultado-codigo aviso-codigo"
                  class="tabular w-full rounded-sm border border-linha-forte bg-papel px-4 py-3 font-mono text-sm uppercase tracking-wider text-tinta placeholder:text-tinta-3 placeholder:normal-case sm:max-w-xs"
                />
                <button
                  type="submit"
                  class="inline-flex items-center justify-center rounded-sm bg-inverso px-6 py-3 text-sm font-medium text-inverso-tinta transition-opacity hover:opacity-85"
                >
                  {c.conferidor.botao}
                </button>
              </div>

              <p
                id="resultado-codigo"
                role="status"
                aria-live="polite"
                class="mt-4 max-w-prose text-sm leading-relaxed"
                hidden
              >
              </p>

              <p id="aviso-codigo" class="mt-6 max-w-prose text-xs leading-relaxed text-tinta-3">
                {c.conferidor.aviso}
              </p>
            </form>
          </div>
        </div>
      </section>
    )}

    {TEM_CHECKOUT && <Checkout t={t} conviteDiscord={CONVITE_DISCORD} />}

    <section>
      <div class="mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-16 lg:px-12">
        <a
          href={caminho(idioma)}
          class="inline-block border-b border-linha-forte pb-0.5 text-sm text-tinta transition-colors hover:border-tinta"
        >
          {c.voltar}
        </a>
      </div>
    </section>
  </main>

  <Rodape t={t} idioma={idioma} sufixo="/comprar" />
</Base>

<script
  is:inline
  define:vars={{
    certo: t.comprar.conferidor.certo,
    errado: t.comprar.conferidor.errado,
    vazio: t.comprar.conferidor.vazio,
  }}
>
  // A MESMA expressao do emissor (bot/otimiza-licenca.cjs). Se uma mudar sem a
  // outra, o site aprova um codigo que o emissor recusa — e a pessoa descobre
  // no pior momento possivel, depois de pagar.
  var FORMA = /^OTZ-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}$/;

  var forma = document.getElementById("forma-codigo");
  var campo = document.getElementById("codigo-maquina");
  var saida = document.getElementById("resultado-codigo");

  if (forma && campo && saida) {
    forma.addEventListener("submit", function (evento) {
      evento.preventDefault();

      // Maiuscula e sem espaco nas pontas: e assim que o emissor trata o
      // codigo antes de conferir. Recusar por causa de um espaco colado junto
      // seria reprovar quem nao errou nada.
      var codigo = String(campo.value || "").trim().toUpperCase();

      var mensagem;
      var cor;

      if (codigo === "") {
        mensagem = vazio;
        cor = "text-tinta-3";
      } else if (FORMA.test(codigo)) {
        mensagem = certo;
        cor = "text-verde";
        campo.value = codigo;
      } else {
        mensagem = errado;
        cor = "text-vermelho";
      }

      saida.className = "mt-4 max-w-prose text-sm leading-relaxed " + cor;
      saida.textContent = mensagem;
      saida.hidden = false;
    });
  }
</script>
