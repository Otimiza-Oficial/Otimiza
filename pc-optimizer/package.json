{
  "name": "pc-optimizer",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "nova": "tauri dev",
    "nova:web": "vite --config vite.nova.config.ts",
    "nova:build": "svelte-check --workspace ui --tsconfig ./tsconfig.json && vite build --config vite.nova.config.ts",
    "build:app": "npm run nova:build",
    "fumaca:nova": "npm run nova:build && node scripts/fumaca-nova.mjs",
    "testes:ui": "node --test ui/testes/queda.test.ts ui/testes/temporadas.test.ts ui/testes/partida.test.ts ui/testes/invoke-solto.test.ts ui/testes/chave.test.ts ui/testes/contexto.test.ts ui/testes/capas.test.ts ui/testes/fila.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
