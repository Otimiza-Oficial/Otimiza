{
  "name": "pc-optimizer",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fumaca": "npm run build && node scripts/clicar-todas-as-areas.mjs",
    "fumaca:nova": "npm run nova:build && node scripts/fumaca-nova.mjs",
    "nova": "tauri dev --config src-tauri/tauri.nova.conf.json",
    "nova:web": "vite --config vite.nova.config.ts",
    "nova:build": "svelte-check --workspace ui --tsconfig ./tsconfig.json && vite build --config vite.nova.config.ts",
    "classico:build": "tsc && vite build --base /classico/ --outDir dist-nova/classico --emptyOutDir",
    "build:app": "npm run nova:build && npm run classico:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.170.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
