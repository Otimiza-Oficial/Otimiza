<!-- Laboratório E6: lê uma gravação do WPR (scripts/laboratorio/gravar-fivem-wpr.ps1) e diz onde o processador
     gastou o tempo durante o jogo. Usa a biblioteca oficial da Microsoft (.NET TraceProcessing).
     Rodar: dotnet run -c Release seguido do caminho do arquivo .etl -->

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.EventTracing.Processing.All" Version="1.12.10" />
  </ItemGroup>
</Project>
