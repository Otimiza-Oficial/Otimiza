{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otimiza",
  "version": "4.0.0",
  "identifier": "com.otimiza.console",
  "build": {
    "beforeDevCommand": "npm run nova:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist-nova"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Otimiza — Console de Desempenho",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://cdn.cloudflare.steamstatic.com https://images.rbxcdn.com https://cdn2.unrealengine.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://cdn.cloudflare.steamstatic.com https://images.rbxcdn.com https://cdn2.unrealengine.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Otimiza",
    "shortDescription": "Console de desempenho para Windows",
    "longDescription": "Mede o desempenho do PC, aplica otimizações reversíveis e prova o resultado com números — inclusive quando não houve ganho.",
    "copyright": "© Otimiza",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/PresentMon"
    ],
    "resources": {
      "binaries/PresentMon-LICENSE.txt": "PresentMon-LICENSE.txt"
    }
  }
}
