{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "otimiza-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "pc-optimizer"
      ],
      "port": 1420
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "otimiza-dist",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "pc-optimizer",
        "vite",
        "preview",
        "pc-optimizer",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}